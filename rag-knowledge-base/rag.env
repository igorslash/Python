# === Core ===
RAG_DATA_DIR=data
RAG_PERSIST_DIR=index
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3

# === Embeddings ===
RAG_EMBEDDING_PROVIDER=openai
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small
# RAG_HF_EMBED_MODEL=intfloat/multilingual-e5-large

# === Generation LLM ===
RAG_LLM_MODEL=gpt-4o-mini
RAG_TEMPERATURE=0

# === Evaluation Judge LLM ===
# MUST be stronger than generation LLM for reliable evaluation
RAG_EVAL_LLM_MODEL=gpt-4o

# === Secrets (NEVER commit real keys!) ===
OPENAI_API_KEY=sk-your-key-here